# Keyed-run template (env-exec) for scripts/forwarder.sh. The token needs only Account > Workers
# Scripts > Edit; `down` does not read AZTEC_NODE_URL.
# op: import
CLOUDFLARE_API_TOKEN=op://Keyed-Runs/Presto-Cloudflare/CLOUDFLARE_API_TOKEN
# op: import
CLOUDFLARE_ACCOUNT_ID=op://Keyed-Runs/Presto-Cloudflare/CLOUDFLARE_ACCOUNT_ID
# op: import
AZTEC_NODE_URL=op://Keyed-Runs/Presto-Testnet/AZTEC_NODE_URL
WRANGLER_SEND_METRICS=false

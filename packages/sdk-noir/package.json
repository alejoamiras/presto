{
  "name": "@alejoamiras/presto-noir",
  "version": "2.0.0-rc.1",
  "description": "Native UltraHonk proving for any Noir circuit through the local Presto app: a drop-in for bb.js's UltraHonkBackend that falls back to WASM.",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejoamiras/presto",
    "directory": "packages/sdk-noir"
  },
  "license": "MIT",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "bun run test:lint && bun run build",
    "test:e2e": "bun test --preload ./e2e/e2e-setup.ts e2e/native.test.ts",
    "test:identity": "bun test --preload ./e2e/e2e-setup.ts e2e/wasm-identity.test.ts",
    "test:lint": "tsc --noEmit --emitDeclarationOnly false && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "bun test --parallel src/"
  },
  "dependencies": {
    "@alejoamiras/presto-core": "workspace:*",
    "@logtape/logtape": "^2.3.2"
  },
  "devDependencies": {
    "@aztec-foundation/bb.js": "6.0.0-rc.1"
  },
  "peerDependencies": {
    "@aztec-foundation/bb.js": "6.0.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

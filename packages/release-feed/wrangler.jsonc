{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "presto-release-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "presto.build/releases/*", "zone_name": "presto.build" }],
  "kv_namespaces": [
    {
      "binding": "PRESTO_RELEASE_FEED",
      "id": "41a6adef830f4a91bf63476a323cec98"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}

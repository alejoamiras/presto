{
  "name": "@alejoamiras/presto",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejoamiras/presto",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test-setup.ts",
    "dist",
    ".claude",
    "AGENTS.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc -w",
    "prepublishOnly": "bun run test:lint && bun run build",
    "test:e2e": "bun test --preload ./e2e/e2e-setup.ts e2e/",
    "test:e2e:remote": "AZTEC_NODE_URL=https://presto-testnet-rpc.alejo-amiras.workers.dev bun test --preload ./e2e/e2e-setup.ts e2e/remote-network.test.ts",
    "test:lint": "tsc --noEmit --emitDeclarationOnly false && tsc -p examples",
    "test:unit": "bun test --parallel src/"
  },
  "dependencies": {
    "@alejoamiras/presto-core": "workspace:*",
    "@aztec-foundation/noir-acvm_js": "6.0.0-rc.1",
    "@aztec-foundation/noir-noirc_abi": "6.0.0-rc.1",
    "@aztec-labs/bb-prover": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@logtape/logtape": "^2.3.2"
  },
  "devDependencies": {
    "@aztec-labs/accounts": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/noir-contracts.js": "6.0.0-rc.1",
    "@aztec-labs/pxe": "6.0.0-rc.1",
    "@aztec-labs/simulator": "6.0.0-rc.1",
    "@aztec-labs/wallets": "6.0.0-rc.1",
    "vite-plugin-node-polyfills": "^0.28"
  },
  "publishConfig": {
    "access": "public"
  }
}

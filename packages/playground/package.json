{
  "name": "@alejoamiras/presto-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:localhost": "AZTEC_NODE_URL=http://localhost:8080 vite",
    "dev:testnet": "AZTEC_NODE_URL=https://presto-testnet-rpc.alejo-amiras.workers.dev vite",
    "preview": "vite preview",
    "test": "bun test",
    "test:e2e": "bunx playwright test --project=mocked",
    "test:e2e:all": "bun run test:e2e && bun run test:e2e:local-network",
    "test:e2e:lna": "bunx playwright test --config=playwright.lna.config.ts",
    "test:e2e:local-network": "bunx playwright test --project=local-network --workers=1",
    "test:e2e:packaged": "bash scripts/test-packaged-e2e.sh",
    "test:e2e:production-smoke": "bash scripts/test-production-smoke.sh",
    "test:e2e:smoke": "bunx playwright test --project=smoke --workers=1",
    "test:live": "bun test src/aztec.test.ts",
    "test:unit": "bun test && bun test ./scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@alejoamiras/presto": "workspace:*",
    "@alejoamiras/presto-banners": "workspace:*",
    "@alejoamiras/presto-noir": "workspace:*",
    "@aztec-foundation/bb.js": "6.0.0-rc.1",
    "@aztec-foundation/noir-acvm_js": "6.0.0-rc.1",
    "@aztec-foundation/noir-noirc_abi": "6.0.0-rc.1",
    "@aztec-labs/accounts": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/bb-prover": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-labs/kv-store": "6.0.0-rc.1",
    "@aztec-labs/noir-contracts.js": "6.0.0-rc.1",
    "@aztec-labs/protocol-contracts": "6.0.0-rc.1",
    "@aztec-labs/pxe": "6.0.0-rc.1",
    "@aztec-labs/simulator": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@aztec-labs/wallets": "6.0.0-rc.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "msgpackr": "1.12.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "viem": "npm:@aztec/viem@2.38.3",
    "vite": "^8.3.0",
    "vite-plugin-node-polyfills": "^0.28"
  }
}
